#!/bin/bash

# =======================================================
# Zientis CLI 工具 - 統一開發工具介面
# =======================================================
# 整合所有開發工具到單一 CLI 介面
# =======================================================

set -e

# 基本配置
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
TOOLS_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT="$(dirname "$TOOLS_DIR")"
VERSION="1.0.0"

# 顏色配置
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 日誌函數
log() { echo -e "${BLUE}[$(date +'%H:%M:%S')]${NC} $1"; }
success() { echo -e "${GREEN}✅ $1${NC}"; }
warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
error() { echo -e "${RED}❌ $1${NC}"; exit 1; }
info() { echo -e "${CYAN}ℹ️  $1${NC}"; }

# 顯示橫幅
show_banner() {
    echo -e "${PURPLE}"
    cat << 'EOF'
 _______ _______ _______ _______ _______ _______ 
|       |_     _|       |       |_     _|       |
|____   | |   | |    ___|    |  | |   | |  _____|
|____|  | |   | |    ___|       | |   | | |_____ 
 _____|  |_|   |_|_______|__|____| |___| |_______|

    🚀 Zientis CLI 工具 v1.0.0
EOF
    echo -e "${NC}"
}

# 顯示主要幫助
show_help() {
    show_banner
    cat << 'EOF'

使用方式: zientis-cli <command> [options] [arguments]

主要命令:
  build                編譯相關命令
    all               編譯所有模組
    <module>          編譯指定模組 (core, economy, social 等)
    watch             監控模式，自動重新編譯變更的模組
    clean             清理編譯快取

  deploy               部署相關命令
    status            查看部署狀態
    <module>          部署指定模組
    all               部署所有模組
    rollback <module> 回滾指定模組到上一版本
    list-backups      列出所有備份
    cleanup           清理舊備份

  setup                環境設定命令
    init              初始化開發環境
    config            配置編輯
    check             檢查環境依賴

  demo                 演示功能
    run               執行演示

  版本與幫助:
    version           顯示版本資訊
    help              顯示此幫助訊息

全域選項:
  -v, --verbose       詳細輸出模式
  -q, --quiet         安靜模式
  -h, --help          顯示幫助
  --dry-run          乾跑模式（顯示將執行的操作但不執行）

範例:
  zientis-cli build all              # 編譯所有模組
  zientis-cli build core             # 只編譯核心模組
  zientis-cli build watch            # 監控模式
  zientis-cli deploy status          # 查看部署狀態
  zientis-cli deploy all             # 部署所有模組
  zientis-cli deploy rollback core   # 回滾核心模組
  zientis-cli setup init             # 初始化環境

詳細說明請使用: zientis-cli <command> --help

EOF
}

# 顯示版本資訊
show_version() {
    echo -e "${CYAN}Zientis CLI v$VERSION${NC}"
    echo "編譯工具整合介面"
    echo ""
    echo "可用工具:"
    echo "  - 自動編譯工具 (build-runner.main.kts)"
    echo "  - 部署管理工具 (deploy-runner.main.kts)" 
    echo "  - 環境設定工具 (setup-runner.main.kts)"
    echo "  - 演示工具 (demo-runner.main.kts)"
}

# 執行 Kotlin 腳本
run_kotlin_script() {
    local script="$1"
    shift
    local script_path="$TOOLS_DIR/$script"
    
    if [[ ! -f "$script_path" ]]; then
        error "腳本不存在: $script"
    fi
    
    # 檢查 kotlin 是否可用
    if ! command -v kotlin &> /dev/null; then
        warning "Kotlin 未安裝，嘗試使用替代方案..."
        
        # 對於編譯，回退到 auto-build.sh
        if [[ "$script" == "build-runner.main.kts" ]]; then
            run_shell_script "auto-build.sh" "$@"
            return
        else
            error "此功能需要安裝 Kotlin。請安裝 Kotlin 後重試。"
        fi
    fi
    
    cd "$PROJECT_ROOT"
    kotlin -s "$script_path" "$@"
}

# 執行 Shell 腳本  
run_shell_script() {
    local script="$1"
    shift
    local script_path="$TOOLS_DIR/$script"
    
    if [[ ! -f "$script_path" ]]; then
        error "腳本不存在: $script"
    fi
    
    cd "$PROJECT_ROOT"
    bash "$script_path" "$@"
}

# 處理 build 命令
handle_build() {
    case "${1:-all}" in
        help|--help|-h)
            cat << 'EOF'
編譯命令使用方式: zientis-cli build <subcommand> [options]

子命令:
  all                  編譯所有模組 (預設)
  <module>             編譯指定模組
  watch               監控模式，自動重新編譯
  clean               清理編譯快取

模組名稱:
  core                zientis-core
  economy             zientis-economy  
  social              zientis-social
  nations             zientis-nations
  multiworld          zientis-multiworld
  display             zientis-display
  discord-api         zientis-discord-api

選項:
  -c, --clean         編譯前先清理
  -q, --quick         快速模式（跳過測試）
  -f, --force         強制重新編譯
  -r, --restart       編譯後重啟伺服器
  -v, --verbose       詳細輸出
  --dry-run          乾跑模式

範例:
  zientis-cli build all              # 編譯所有模組
  zientis-cli build core --clean     # 清理並編譯核心模組
  zientis-cli build watch            # 監控模式
  zientis-cli build --quick --force  # 快速強制編譯所有模組
EOF
            ;;
        all)
            shift
            run_kotlin_script "build-runner.main.kts" --all "$@"
            ;;
        watch)
            shift
            run_kotlin_script "build-runner.main.kts" --watch "$@"
            ;;
        clean)
            shift  
            run_kotlin_script "build-runner.main.kts" --clean --all "$@"
            ;;
        core|economy|social|nations|multiworld|display|discord-api)
            local module="$1"
            shift
            run_kotlin_script "build-runner.main.kts" "$module" "$@"
            ;;
        *)
            # 當作模組名稱或選項處理
            run_kotlin_script "build-runner.main.kts" "$@"
            ;;
    esac
}

# 處理 deploy 命令
handle_deploy() {
    case "${1:-help}" in
        help|--help|-h)
            cat << 'EOF'
部署命令使用方式: zientis-cli deploy <subcommand> [options]

子命令:
  status              查看部署狀態
  <module>            部署指定模組
  all                 部署所有模組
  rollback <module>   回滾指定模組
  list-backups        列出所有備份
  cleanup             清理舊備份

選項:
  -f, --force         強制部署
  -v, --verbose       詳細輸出
  --dry-run          乾跑模式

範例:
  zientis-cli deploy status          # 查看狀態
  zientis-cli deploy core            # 部署核心模組
  zientis-cli deploy all             # 部署所有模組
  zientis-cli deploy rollback core   # 回滾核心模組
EOF
            ;;
        status)
            shift
            run_kotlin_script "deploy-runner.main.kts" status "$@"
            ;;
        all)
            shift
            run_kotlin_script "deploy-runner.main.kts" deploy-all "$@"
            ;;
        rollback)
            shift
            if [[ $# -eq 0 ]]; then
                error "請指定要回滾的模組名稱"
            fi
            run_kotlin_script "deploy-runner.main.kts" rollback "$@"
            ;;
        list-backups)
            shift
            run_kotlin_script "deploy-runner.main.kts" list-backups "$@"
            ;;
        cleanup)
            shift
            run_kotlin_script "deploy-runner.main.kts" cleanup "$@"
            ;;
        *)
            # 當作模組名稱處理
            run_kotlin_script "deploy-runner.main.kts" deploy "$@"
            ;;
    esac
}

# 處理 setup 命令
handle_setup() {
    case "${1:-help}" in
        help|--help|-h)
            cat << 'EOF'
設定命令使用方式: zientis-cli setup <subcommand> [options]

子命令:
  init                初始化開發環境
  config              編輯配置檔案
  check               檢查環境依賴

範例:
  zientis-cli setup init             # 初始化環境
  zientis-cli setup check            # 檢查依賴
EOF
            ;;
        init)
            shift
            run_kotlin_script "setup-runner.main.kts" init "$@"
            ;;
        config)
            shift
            run_kotlin_script "setup-runner.main.kts" config "$@"
            ;;
        check)
            shift
            run_kotlin_script "setup-runner.main.kts" check "$@"
            ;;
        *)
            run_kotlin_script "setup-runner.main.kts" "$@"
            ;;
    esac
}

# 處理 demo 命令
handle_demo() {
    case "${1:-run}" in
        help|--help|-h)
            cat << 'EOF'
演示命令使用方式: zientis-cli demo [subcommand] [options]

子命令:
  run                 執行演示 (預設)

範例:
  zientis-cli demo run               # 執行演示
EOF
            ;;
        *)
            run_kotlin_script "demo-runner.main.kts" "$@"
            ;;
    esac
}

# 主函數
main() {
    # 解析全域選項
    local verbose=false
    local quiet=false
    local dry_run=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -v|--verbose)
                verbose=true
                export VERBOSE=true
                shift
                ;;
            -q|--quiet)
                quiet=true
                export QUIET=true
                shift
                ;;
            --dry-run)
                dry_run=true
                export DRY_RUN=true
                shift
                ;;
            -h|--help|help)
                show_help
                exit 0
                ;;
            version|--version)
                show_version
                exit 0
                ;;
            build)
                shift
                handle_build "$@"
                exit 0
                ;;
            deploy)
                shift  
                handle_deploy "$@"
                exit 0
                ;;
            setup)
                shift
                handle_setup "$@"
                exit 0
                ;;
            demo)
                shift
                handle_demo "$@"
                exit 0
                ;;
            -*) 
                error "未知選項: $1"
                ;;
            *)
                error "未知命令: $1。使用 'zientis-cli help' 查看可用命令。"
                ;;
        esac
    done
    
    # 沒有參數時顯示幫助
    show_help
}

# 執行主函數
main "$@"